generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Direction {
  INCOME
  EXPENSE
}

enum Category {
  SUBSCRIPTION
  RENT
  BILL
  BANK
  GOVERNMENT
  OTHER
}

model RecurringItem {
  id          String    @id @default(cuid())
  name        String
  amountCents Int
  direction   Direction
  category    Category
  notes       String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Settings {
  id       Int    @id @default(1)
  currency String @default("EUR")
  bankBalanceCents Int @default(0)
}
