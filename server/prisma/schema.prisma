generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Direction {
  INCOME
  EXPENSE
}

enum Category {
  SUBSCRIPTION
  RENT
  BILL
  BANK
  GOVERNMENT
  OTHER
}

model User {
  id        String    @id @default(cuid())
  clerkId   String    @unique
  email     String?
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  months    Month[]
  goals     Goal[]
  settings  Settings?
}

model Month {
  id                  String          @id @default(cuid())
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  year                Int
  month               Int
  bankBalanceCents    Int             @default(0)
  krakenBalanceCents  Int?
  krakenEarnCents     Int?
  krakenSpotCents     Int?
  krakenSnapshottedAt DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  items               RecurringItem[]

  @@unique([userId, year, month])
  @@index([userId])
}

model RecurringItem {
  id          String    @id @default(cuid())
  monthId     String
  month       Month     @relation(fields: [monthId], references: [id], onDelete: Cascade)
  name        String
  amountCents Int
  direction   Direction
  category    Category
  billingDay  Int?
  notes       String?
  active      Boolean   @default(true)
  paid        Boolean   @default(false)
  oneOff      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([monthId])
}

model Goal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  targetCents Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Settings {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency String @default("EUR")
}
