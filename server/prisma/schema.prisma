generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Direction {
  INCOME
  EXPENSE
}

enum Category {
  SUBSCRIPTION
  RENT
  BILL
  BANK
  GOVERNMENT
  OTHER
}

model Month {
  id                  String          @id @default(cuid())
  year                Int
  month               Int
  bankBalanceCents    Int             @default(0)
  krakenBalanceCents  Int?
  krakenEarnCents     Int?
  krakenSpotCents     Int?
  krakenSnapshottedAt DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  items               RecurringItem[]

  @@unique([year, month])
}

model RecurringItem {
  id          String    @id @default(cuid())
  monthId     String
  month       Month     @relation(fields: [monthId], references: [id], onDelete: Cascade)
  name        String
  amountCents Int
  direction   Direction
  category    Category
  billingDay  Int?
  notes       String?
  active      Boolean   @default(true)
  paid        Boolean   @default(false)
  oneOff      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([monthId])
}

model Goal {
  id          String   @id @default(cuid())
  name        String
  targetCents Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Settings {
  id       Int    @id @default(1)
  currency String @default("EUR")
}
