# Neon Postgres (local + Render). Never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Clerk (Development secret key)
CLERK_SECRET_KEY=sk_test_...

# Comma-separated browser origins allowed to call GraphQL (defaults to local Vite + Pages).
# CORS_ORIGIN="http://localhost:5173,https://your-finance-tracker.pages.dev"

# Kraken (Query Funds permission). Never commit real keys.
KRAKEN_API_KEY=""
KRAKEN_API_SECRET=""
