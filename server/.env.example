# Neon Postgres (local + Render). Never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Comma-separated browser origins allowed to call GraphQL (defaults to local Vite).
# CORS_ORIGIN="http://localhost:5173,https://your-app.pages.dev"

# Kraken (Query Funds permission). Never commit real keys.
KRAKEN_API_KEY=""
KRAKEN_API_SECRET=""
